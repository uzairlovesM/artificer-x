sdk.dir=/data/data/com.termux/files/home/android-sdk
GROQ_API_KEY=REPLACE_WITH_YOUR_OWN_GROQ_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OWN_OPENROUTER_KEY
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_OWN_CLOUDFLARE_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_OWN_CLOUDFLARE_ACCOUNT_ID

# ── Release signing (personal build — never share this file or the .p12) ──
# Generated once via keytool; RSA-4096, PKCS12, 30-year validity.
# Same password serves as both store and key password (PKCS12 requirement).
RELEASE_STORE_FILE=keystore/artificerx-release.keystore.p12
RELEASE_STORE_PASSWORD=REPLACE_WITH_YOUR_OWN_STORE_PASSWORD
RELEASE_KEY_ALIAS=artificerx-release
RELEASE_KEY_PASSWORD=REPLACE_WITH_YOUR_OWN_KEY_PASSWORD
